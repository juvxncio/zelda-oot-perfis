/* Os ganchos em funções internas do main (build E0F3CCFA, 1.1.1). Fonte única: incluída por
 * mod/ganchos.h (X-macro) e lida por tools/mkips.py, que gera o patch IPS32 do exefs.
 *
 *   GANCHO(nome, offset no main, instrução original nesse offset)
 *
 * A instrução original é copiada para o desvio na caverna, então não pode depender do PC
 * (adr/adrp/b/bl/cbz/tbz/ldr literal): o mkips.py recusa. A ordem define o índice do gancho
 * e não deve mudar sem regerar o patch. */

/* UISystemOptionScreen, vt+0x2f0: cria as linhas da tela de Opções (this, heap). */
GANCHO(OPCOES_CRIAR, 0x34011c0, 0xd503237f)

/* A lista lida de OptionSetTable.bgyml ({int n; entrada[40] *e}). Só a tela de Opções e os
 * botões dela chamam estas três (conferido com analisar_main.py). */
GANCHO(LISTA_CONTA, 0x339c5a0, 0xd503237f)      /* (lista) -> quantas linhas visíveis */
GANCHO(LISTA_PEGA, 0x339c630, 0xd503237f)       /* (lista, i) -> i-ésima linha visível */
GANCHO(LISTA_POR_TIPO, 0x339c790, 0xb9400008)   /* (lista, tipo de opção) -> a linha */

/* Botão de escolha (Select) da tela de Opções: atualiza o texto da escolha atual (this). */
GANCHO(SELECT_TEXTO, 0x33cf7f0, 0xd503237f)

/* Busca de mensagem dos layouts: (saída {texto, tamanho, ...}, arquivo, rótulo, flag) -> 1 se
 * achou. É por onde "MessageWindowTransparency_Title" etc. viram "MsgNotFound". */
GANCHO(MSG_PEGAR, 0xa6afe0, 0xd503237f)
